# PostgreSQL
PG_USER=postgres
PG_PASSWORD=postgres
PG_HOST=localhost
PG_PORT=5432
PG_DB=deforestation

# Global Forest Watch API
GFW_API_KEY=your_api_key_here

# AWS S3 — bucket donde se almacenan los CSVs raw
S3_BUCKET=your-bucket-name
S3_PREFIX=deforestacion-alert-etl/
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1

# URL base del proxy que expone los archivos desde S3
# Estructura: https://docs.jhoanhurtado.com/deforestacion-alert-etl/<path>/<real_filename>
DATA_PROXY_URL=https://docs.jhoanhurtado.com

# Apache Airflow (puerto 9179, subdominio: airflow.jhoanhurtado.com)
AIRFLOW_PORT=9179
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=admin
AIRFLOW_FIRSTNAME=Jhoan
AIRFLOW_LASTNAME=Hurtado
AIRFLOW_EMAIL=jhoanezequielh@gmail.com

# WDPA — World Database on Protected Areas (opcional, fallback estático si no se configura)
# Obtener token gratuito en: https://api.protectedplanet.net/request
WDPA_TOKEN=your_wdpa_token_here
