# PostgreSQL
PG_USER=postgres
PG_PASSWORD=postgres
PG_HOST=localhost
PG_PORT=5432
PG_DB=deforestation

# Global Forest Watch API
GFW_API_KEY=your_api_key_here

# AWS S3 — bucket donde se almacenan los CSVs raw
S3_BUCKET=your-bucket-name
S3_PREFIX=raw/                  # prefijo dentro del bucket (opcional)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1

# URL del proxy inverso que expone los CSVs desde S3
DATA_PROXY_URL=https://your-proxy-domain.com/data
